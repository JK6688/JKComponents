{
  "name": "jk-vue-comps",
  "version": "0.2.28",
  "description": "jk-vue-comps",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "vite",
    "vue3",
    "tsx",
    "JK",
    "TelegramAuth",
    "GoogleAuth"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm delete:dist && vue-tsc && vite build",
    "preview": "vite preview",
    "ts:check": "tsc --project tsconfig.json --noEmitOnError",
    "delete:lib": "rimraf pnpm-lock.yaml node_modules",
    "delete:dist": "rimraf dist.zip dist",
    "delete:all": "pnpm delete:dist && pnpm delete:lib",
    "lint:ox": "oxlint . --fix -D no-undef",
    "lint:fmt": "oxfmt",
    "lint:all": "pnpm lint:fmt && pnpm lint:ox"
  },
  "dependencies": {
    "bignumber.js": "11.1.5",
    "vue-types": "7.0.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "rimraf": "^6.1.3",
    "vue": "3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
